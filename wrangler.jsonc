{
  // Cloudflare Workers の設定ファイル
  // フォークした人もこのファイルは基本的にそのままで動きます。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "personal-dashboard",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  // 画面（HTML/CSS/JS）は public/ から配信し、/api/* だけ Worker のコードを通す
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // ダッシュボードの中身（リンクやレイアウト）の保存先。
  // id を書かなくても、初回デプロイ時に KV ネームスペースが自動で作られます。
  "kv_namespaces": [
    { "binding": "DASHBOARD_KV" }
  ],

  // https://personal-dashboard.<あなたのサブドメイン>.workers.dev で公開
  "workers_dev": true,
  // ブランチごとのプレビュー URL は Access の保護対象外になりうるので無効化
  "preview_urls": false,

  // TEAM_DOMAIN / POLICY_AUD / ALLOWED_EMAILS は Cloudflare ダッシュボードで設定します。
  // デプロイ時に消されないよう、ダッシュボード側の変数を保持する。
  "keep_vars": true,

  "observability": { "enabled": true }
}
