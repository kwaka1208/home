rules_version = '2';

// Firestore のセキュリティルール
//
// 下の allowedEmails() の中を、ログインを許可する Google アカウントのメールアドレスに
// 書き換えてから、Firebase コンソールの「Firestore Database → ルール」に
// このファイルの内容をすべて貼り付けて「公開」してください（README の手順 4）。
//
// - メールアドレスは小文字で書いてください
// - 複数の人に使わせる場合は ['a@gmail.com', 'b@gmail.com'] のようにカンマで区切ります
//   ・ふだんは、データは人ごとに別々に保存され、他の人のデータは読めません
//   ・firebase-config.js で SHARED_DASHBOARD = true にすると、ここに書いた全員で
//     dashboards/shared の 1 つのダッシュボードを共有します
service cloud.firestore {
  match /databases/{database}/documents {

    function allowedEmails() {
      return ['you@example.com'];
    }

    // ログインしていて、許可したメールアドレスであること
    function isAllowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in allowedEmails();
    }

    // 読み書きしてよいドキュメントか：本人のもの（dashboards/{uid}）か、共有のもの（dashboards/shared）
    function canUse(docId) {
      return isAllowed() && (request.auth.uid == docId || docId == 'shared');
    }

    // 保存する内容の形と大きさを確認する
    function isValidDashboard() {
      return request.resource.data.keys().hasOnly(['json', 'updatedAt'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 500000
        && request.resource.data.updatedAt == request.time;
    }

    match /dashboards/{docId} {
      allow read, delete: if canUse(docId);
      allow create, update: if canUse(docId) && isValidDashboard();
    }

    // これ以外の場所は、すべて読み書き禁止
  }
}
